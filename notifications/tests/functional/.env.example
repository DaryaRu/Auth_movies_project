POSTGRES_PORT=5432
POSTGRES_DB=notifications
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres

KAFKA_BROKERS=kafka:9092
KAFKA_READY_TOPIC=notification-ready
KAFKA_PENDING_TOPIC=notification-pending
KAFKA_RETRY_INTERVAL_SEC=1
KAFKA_ACKS=all

SERVICE_WAIT_MAX_ATTEMPTS=30
SERVICE_WAIT_DELAY=1.0

API_URL=http://test-notifications-service:8000
API_V1_PREFIX=/api/v1

# Секрет для межсервисных вызовов (X-Internal-Secret) — требуется на
# POST /admin-mailings/, GET /templates/by-code/{code}/, POST /triggers/.
INTERNAL_SERVICE_SECRET=<internal_service_secret>

DEBUG=0
ENVIRONMENT=test

PYTHON_VERSION=3.12

# auth-service (для регистрации тестовых юзеров с таймзонами)
AUTH_API_URL=http://auth-service:8000/api/v1
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=postgres
AUTH_POSTGRES_HOST=auth-db
AUTH_POSTGRES_PORT=5432

ALLOWED_HOSTS=*
ORIGINS=*
PROJECT_NAME=AUTH_FUNCTEST
PRIVATE_KEY_PATH=/app/keys/private.pem
PUBLIC_KEY_PATH=/app/keys/public.pem
HASH_TIME_COST=2
HASH_MEMORY_COST=65536
HASH_PARALLELISM=1
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=auth-functest
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health
