POSTGRES_PORT=5432
POSTGRES_DB=movies
POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345678
POSTGRES_HOST=postgres

REDIS_HOST=redis
REDIS_PORT=6379

SERVICE_WAIT_MAX_ATTEMPTS=30
SERVICE_WAIT_DELAY=1.0

API_URL=http://fastapi-auth:7000
API_PREFIX=/api/v1

PRIVATE_KEY_PATH=/app/keys/private.pem
PUBLIC_KEY_PATH=/app/keys/public.pem

HASH_TIME_COST=3
HASH_MEMORY_COST=65536
HASH_PARALLELISM=2

JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_HOSTS=*
ORIGINS=*

PROJECT_NAME=AUTH
COOKIE_SECURE=0
CACHE_EXPIRE=600

OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_STATE_EXPIRE_SECONDS=300
GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>

YANDEX_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
YANDEX_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

CODE_2FA_EXPIRE_SECONDS=300
TWO_FA_MAX_ATTEMPTS=5
TWO_FA_MAX_SENDS_PER_WINDOW=5
TWO_FA_SEND_RATE_WINDOW_SECONDS=3600
TWO_FA_SEND_COOLDOWN_SECONDS=60

PHONE_CHANGE_CODE_EXPIRE_SECONDS=300
PHONE_CHANGE_MAX_ATTEMPTS=5
PHONE_CHANGE_MAX_SENDS_PER_WINDOW=5
PHONE_CHANGE_SEND_RATE_WINDOW_SECONDS=3600
PHONE_CHANGE_SEND_COOLDOWN_SECONDS=60

# Нужен реальный тестовый аккаунт SMSC с включенным виртуальным режимом
# (Настройки → API/SMPP → Режим тестирования).
# Тесты 2FA/смены телефона реально дергают smsc.ru (виртуальная отправка бесплатна).
SMSC_LOGIN=<smsc_login>
SMSC_PASSWORD=<smsc_password>
SMSC_TEST_MODE=1
SMSC_SENDER_NAME=<smsc_sender_name>

# Реальный номер, на который тесты будут отправлять код
# (SMSC отклоняет синтетические номера даже в виртуальном режиме).
TEST_PHONE_NUMBER=<real_phone_number>

DEBUG=0
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_SERVICE_NAME=auth-service
ENVIRONMENT=test
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS="/health"
